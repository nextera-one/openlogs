{
  "name": "@nextera.one/openlogs-sdk",
  "version": "2.2.0",
  "description": "TypeScript/JavaScript SDK for OpenLogs v2 (Reality Containers)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1.mjs",
      "require": "./dist/v1.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.mjs",
      "require": "./dist/keys.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "keywords": [
    "openlogs",
    "logging",
    "verifiable",
    "hash-chain",
    "ed25519",
    "sdk"
  ],
  "author": "NextEra.One",
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@nextera.one/tps-standard": "^0.7.0",
    "@noble/ed25519": "^3.0.1",
    "@noble/hashes": "^2.0.1",
    "ulid": "^3.0.2"
  }
}
